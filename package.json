{
  "name": "mcp-vs-cli",
  "private": true,
  "type": "module",
  "description": "What does an MCP server cost in context, and what do you get back for it?",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "check": "biome check . && tsc --noEmit && bun test src",
    "fix": "biome check --write .",
    "measure": "bun run src/measure.ts",
    "ground-truth": "bun run src/scripts/check-ground-truth.ts",
    "run-arms": "bun run src/scripts/run-arms.ts",
    "build:cli": "bun build src/artifacts/cli-main.ts --compile --outfile bin/api",
    "setup:harness": "git submodule update --init vendor/deepseek-harness && cd vendor/deepseek-harness && CI=true corepack pnpm install --frozen-lockfile && CI=true corepack pnpm run build"
  },
  "imports": {
    "#dsh/cordis": "./src/vendor/cordis.mjs",
    "#dsh/llm": "./vendor/deepseek-harness/packages/llm/llm/lib/index.js",
    "#dsh/llm-pi-ai": "./vendor/deepseek-harness/packages/llm/llm-pi-ai/lib/index.js",
    "#dsh/token-meter": "./vendor/deepseek-harness/packages/llm/token-meter/lib/index.js",
    "#dsh/session": "./vendor/deepseek-harness/packages/core/session/lib/index.js",
    "#dsh/system-prompt": "./vendor/deepseek-harness/packages/core/system-prompt/lib/index.js",
    "#dsh/tools": "./vendor/deepseek-harness/packages/core/tools/lib/index.js",
    "#dsh/agent": "./vendor/deepseek-harness/packages/core/agent/lib/index.js",
    "#dsh/agent-loop": "./vendor/deepseek-harness/packages/core/agent-loop/lib/index.js",
    "#dsh/credentials-local": "./vendor/deepseek-harness/packages/credentials/credentials-local/lib/index.js",
    "#dsh/shell-env": "./vendor/deepseek-harness/packages/shell/shell-env/lib/index.js",
    "#dsh/tool-bash": "./vendor/deepseek-harness/packages/shell/tool-bash/lib/index.js",
    "#dsh/bash-sandbox": "./vendor/deepseek-harness/packages/shell/bash-sandbox/lib/index.js",
    "#dsh/sandbox-local": "./vendor/deepseek-harness/packages/sandbox/sandbox-local/lib/index.js",
    "#dsh/sandbox-policy": "./vendor/deepseek-harness/packages/sandbox/sandbox-policy/lib/index.js",
    "#dsh/subprocess-local": "./vendor/deepseek-harness/packages/subprocess/subprocess-local/lib/index.js",
    "#dsh/mcp-client": "./vendor/deepseek-harness/packages/mcp/mcp-client/lib/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@readme/openapi-parser": "^6.3.1",
    "commander": "^15.0.0",
    "jq-wasm": "^3.0.0-jq-1.8.2",
    "js-tiktoken": "^1.0.15",
    "ky": "^2.0.2",
    "openapi-types": "^12.1.3",
    "pure-rand": "^8.4.2",
    "typebox": "^1.3.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
