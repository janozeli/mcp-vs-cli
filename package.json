{
  "name": "mcp-vs-cli",
  "private": true,
  "type": "module",
  "description": "What does an MCP server cost in context, and what do you get back for it?",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "check": "biome check . && tsc --noEmit && bun test",
    "fix": "biome check --write .",
    "measure": "bun run src/measure.ts",
    "ground-truth": "bun run src/scripts/check-ground-truth.ts",
    "run-arms": "bun run src/scripts/run-arms.ts",
    "build:cli": "bun build src/artefacts/cli-main.ts --compile --outfile bin/api"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@readme/openapi-parser": "^6.3.1",
    "commander": "^15.0.0",
    "jq-wasm": "^3.0.0-jq-1.8.2",
    "js-tiktoken": "^1.0.15",
    "ky": "^2.0.2",
    "openapi-types": "^12.1.3",
    "pi-mcp-adapter": "^2.17.0",
    "pure-rand": "^8.4.2",
    "typebox": "^1.3.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
